{
    "name": "somardigital/silverstripe-redis",
	"description": "A silverstripe module providing Redis caching and session handling",
	"type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "redis"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "silverstripe/framework": "^6.0",
        "predis/predis": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "Somar\\Redis\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "replace": {
        "somardesignstudios/silverstripe-redis": "*"
    }
  }
